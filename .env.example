# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =============================================================================
# SOLUTION 1: FULL-STACK NODE.JS SERVER (server.ts / Express)
# Used when deploying with Node.js running backend mail relay
# =============================================================================
# SMTP Server hostname (e.g., smtp.gmail.com, smtp.hostinger.com, smtp.mailgun.org)
SMTP_HOST="smtp.gmail.com"

# SMTP Server Port: 587 (TLS/STARTTLS) or 465 (SSL)
SMTP_PORT="587"

# SMTP Username / Sender Email
SMTP_USER="affandark@gmail.com"

# SMTP Password or App Password (for Gmail: generate a 16-character App Password at myaccount.google.com/apppasswords)
SMTP_PASS="your-smtp-app-password"

# Set to "true" if using port 465
SMTP_SECURE="false"

# From Address header shown in client inboxes
SMTP_FROM="WheelClarify Support & Vehicle Audits <affandark@gmail.com>"

# Primary Administrator Email for inbound tickets and order alerts
ADMIN_EMAIL="affandark@gmail.com"

# =============================================================================
# SOLUTION 2: STATIC HOSTINGER / APACHE / CPANEL HOSTING (dist folder upload)
# Used when uploading static HTML/JS/CSS without a running Node.js server.
# Web3Forms delivers messages directly from the browser to your admin inbox!
# =============================================================================
# Free Web3Forms Access Key: Get one in 30 seconds at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=""

# =============================================================================
# PAYMENT GATEWAYS (Stripe & PayPal Live Credentials)
# =============================================================================
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_TEST_MODE="true"

PAYPAL_CLIENT_ID="BAA..."
PAYPAL_SECRET_KEY="EDK..."
PAYPAL_SANDBOX_MODE="true"
